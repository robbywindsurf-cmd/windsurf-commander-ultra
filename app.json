{
  "expo": {
    "name": "windsurf-commander-ultra",
    "slug": "windsurf-commander-ultra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#061f2e",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#061f2e",
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.commandersuite.windsurf",
      "infoPlist": {
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false
        },
        "NSPhotoLibraryUsageDescription": "Windsurf Commander needs access to your photos to analyse your windsurfing videos and save Peak Moment cards.",
        "NSPhotoLibraryAddUsageDescription": "Save your Peak Moment to Photos",
        "NSCameraUsageDescription": "Windsurf Commander needs camera access for live pose analysis.",
        "UTImportedTypeDeclarations": [
          {
            "UTTypeConformsTo": [
              "public.data",
              "public.movie"
            ],
            "UTTypeDescription": "GoPro 360 Video",
            "UTTypeIdentifier": "com.gopro.mediasdk.sphericalvideo",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "360"
              ]
            }
          },
          {
            "UTTypeConformsTo": [
              "public.data",
              "public.movie"
            ],
            "UTTypeDescription": "GoPro 360 Low Res Video",
            "UTTypeIdentifier": "com.gopro.mediasdk.sphericallowres",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "360"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "ios": { "withSQLiteVecExtension": true },
          "android": { "withSQLiteVecExtension": true }
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      "llama.rn",
      "./plugins/withGoProSDK.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.6"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Access Photos to save Peak Moment cards",
          "savePhotosPermission": "Save your Peak Moment to Photos"
        }
      ]
    ]
  }
}
