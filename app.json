{
  "expo": {
    "name": "windsurf-commander-ultra",
    "slug": "windsurf-commander-ultra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": false,
      "bundleIdentifier": "com.anonymous.windsurf-commander-ultra",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Windsurf Commander needs access to your photos to analyse your windsurfing videos.",
        "NSCameraUsageDescription": "Windsurf Commander needs camera access for live pose analysis.",
        "UTImportedTypeDeclarations": [
          {
            "UTTypeConformsTo": [
              "public.data",
              "public.movie"
            ],
            "UTTypeDescription": "GoPro 360 Video",
            "UTTypeIdentifier": "com.gopro.mediasdk.sphericalvideo",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "360"
              ]
            }
          },
          {
            "UTTypeConformsTo": [
              "public.data",
              "public.movie"
            ],
            "UTTypeDescription": "GoPro 360 Low Res Video",
            "UTTypeIdentifier": "com.gopro.mediasdk.sphericallowres",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "360"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-video",
      "./plugins/withGoProSDK.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.6"
          }
        }
      ]
    ]
  }
}
